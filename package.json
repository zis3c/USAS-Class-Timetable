{
  "name": "timetable-usas",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && npx wrangler pages dev dist",
    "build": "vite build",
    "preview": "vite preview",
    "preview:cf": "npm run build && npx wrangler pages dev dist",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist",
    "lint": "eslint .",
    "lint:repo": "eslint .",
    "lint:security": "eslint -c eslint.security.config.js src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:strict": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:e2e": "playwright test --reporter=line",
    "test:all": "npm run test:strict && npm run test:e2e"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.344.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.8.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
